package spring.interview.spring_practice.UserServices;
import org.springframework.stereotype.Component;
public interface Cars {
    public String car();
}

@Component("petrol")
class petrol implements Cars{

    @Override
    public String car() {
        return "using petrol engine";
    }
}

@Component("diesel")
class Diesel implements Cars{

    @Override
    public String car() {
        return "using diesel engine";
