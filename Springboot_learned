package spring.interview.spring_practice.UserControllers;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import spring.interview.spring_practice.UserServices.Cars;

@RestController
@RequestMapping("/api")
public class CarController {

    private final Cars dieselCar;
    private final Cars petrolCar;

    public CarController(@Qualifier("diesel") Cars dieselCar,@Qualifier("petrol") Cars petrolCar){
        this.dieselCar=dieselCar;
        this.petrolCar=petrolCar;
    }

    @GetMapping("/car/diesel")
    public String diesel(){
        return "car is running using "+dieselCar.car();
    }

    @GetMapping("/car/petrol")
    public String petrol(){
        return "car is running using "+petrolCar.car();
    }
}

